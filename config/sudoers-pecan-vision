# Allow the kit user to manage the recorder service and apply updates without a password
# Installed to /etc/sudoers.d/pecan-vision by setup-kit.sh / bootstrap-kit.sh
# Placeholders @KIT_USER@ and @KIT_ROOT@ are rewritten at install time.
@KIT_USER@ ALL=(root) NOPASSWD: /bin/systemctl start pecan-vision.service, /bin/systemctl stop pecan-vision.service, /bin/systemctl restart pecan-vision.service, /bin/systemctl status pecan-vision.service, /bin/systemctl is-active pecan-vision.service, /usr/bin/setsid /usr/bin/bash @KIT_ROOT@/scripts/apply-update.sh
