[Unit]
Description=Pecan Vision Kit web recorder
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/recordings

[Service]
Type=simple
User=@KIT_USER@
Group=@KIT_USER@
WorkingDirectory=@KIT_ROOT@/app
ExecStart=@KIT_ROOT@/.venv/bin/python @KIT_ROOT@/app/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Camera + video group access
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
